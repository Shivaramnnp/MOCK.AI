# MOCK.AI Web Client Environment Configuration
# Copy this file to .env.local and fill in your values.
# IMPORTANT: Only public, client-safe keys with the VITE_ prefix belong here.
# NEVER expose your Supabase service_role key or sb_secret_* in the frontend!

# =============================================================================
# SUPABASE PROJECT 1 — AUTHENTICATION
# Purpose: User login, registration, profiles, credentials
# This is the ONLY project that handles auth. Do NOT add auth to Project 2.
# =============================================================================
VITE_SUPABASE_URL=https://your-auth-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-auth-project-anon-key

# =============================================================================
# SUPABASE PROJECT 2 — EXAM CONTENT
# Purpose: Exams, papers, questions, options, answers, visual assets
# DO NOT use this for authentication.
# DO NOT store passwords or user credentials here.
# =============================================================================
VITE_SUPABASE_CONTENT_URL=https://your-content-project-ref.supabase.co
VITE_SUPABASE_CONTENT_KEY=your-content-project-publishable-key
